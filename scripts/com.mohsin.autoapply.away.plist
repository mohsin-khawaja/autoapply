<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mohsin.autoapply.away</string>

    <!-- Away mode loops internally, so launchd only has to keep it alive. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/mohsinkhawaja/autoapply &amp;&amp; AUTOAPPLY_LLM=ollama AUTOAPPLY_AUTO_SUBMIT=greenhouse,lever,ashby exec /Users/mohsinkhawaja/.local/bin/uv run autoapply away --interval 45m --max 40</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- Restart if the process dies (browser crash, OOM); the loop itself
         already survives per-cycle failures. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/mohsinkhawaja/autoapply/runs/away.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mohsinkhawaja/autoapply/runs/away.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/mohsinkhawaja/autoapply</string>
</dict>
</plist>
